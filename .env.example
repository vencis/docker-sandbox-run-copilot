# =============================================================================
# Docker Sandbox Copilot CLI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# GitHub Copilot Token (required for Copilot CLI authentication)
# Create a Copilot token at: https://github.com/settings/tokens
# Required scopes: copilot, read:user
GITHUB_COPILOT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: HTTPS proxy for image builds and the running container
# https_proxy=http://proxy.example:8080

# Optional: IDs for the container user (set to the output of id -u and id -g)
AGENT_UID=1000
AGENT_GID=1000

# Optional: Git user configuration (injected into container)
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your.email@example.com

# Optional: Workspace path to mount (defaults to current directory)
# WORKSPACE_PATH=/path/to/your/project
